# Copy file này thành .env rồi điền API key (lấy tại https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Model dự phòng khi model chính hết quota, cách nhau bởi dấu phẩy
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash
GEMINI_TIMEOUT_MS=30000
AI_CACHE_SECONDS=600
